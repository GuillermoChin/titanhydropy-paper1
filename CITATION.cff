    given-names: "Guillermo Adrian"
    affiliation: "Instituto Tecnológico Superior de Calkiní (ITESCAM), Calkiní, Campeche, Mexico"
    orcid: "https://orcid.org/0000-0003-2104-6625"
license: MIT
version: "1.0.1"
date-released: "2026-09-11"
keywords:
  - Titan
  - meteotsunami
  - Proudman resonance
  - shallow-water equations
  - numerical modelling
  - hydrocarbon seas
  - planetary science
  - open-source software
repository-code: "https://github.com/guillermochin/titanhydropy-paper1"

# NOTA. Este fichero cita EL SOFTWARE. No lleva `preferred-citation` a
# proposito: el manuscrito asociado esta en revision y todavia no tiene
